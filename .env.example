# Copy to .env and fill in. .env is gitignored; no secrets are committed.

# Required — the LLM behind every agent.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required — news and sentiment for the News Analyst.
# https://www.marketaux.com/
MARKETAUX_API_TOKEN=

# Optional — ship OpenTelemetry traces to a dashboard.
# Without these the system still writes data/traces/last_run.log and prints
# a trace summary after every run. See the README for a one-command Jaeger
# setup. Use the _TRACES_ variable, not the generic OTEL_EXPORTER_OTLP_ENDPOINT:
# that one also routes metrics, which Jaeger does not implement.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=dailydollar
